{
  "measured": [
    "engine",
    "chrysalis",
    "Makefile"
  ],
  "harness": [
    "bench"
  ],
  "share": [
    "data",
    "build/cmp_strata/ref.bin",
    "build/bench/ref-27b.bin"
  ],
  "build": "make -s engines && if [ \"$(uname -s)\" = Linux ]; then make -s build/vram_peak.so; fi",
  "readme": "README.md",
  "machines": {
    "5f3343802dde1de1": "RX 7900 XTX",
    "37faa95555ab4a0d": "M4 Max"
  },
  "groups": [
    "Speed",
    "Quality",
    "Memory and context",
    "Energy",
    "Build",
    "Against competitors"
