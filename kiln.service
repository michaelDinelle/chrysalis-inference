[Unit]
Description=kiln - Qwen3.8-27B / Qwen3.8-Flash-Next inference server (OpenAI API, port 8080)

[Service]
ExecStart=@ROOT@/kiln.sh serve
Restart=on-failure
RestartSec=3
# Flash-Next's cold experts (~43 GB) live in this process's memory, and with the high swappiness of a zram setup
# (Omarchy: 150) the kernel moved them to swap under pressure as soon as file cache: every turn then waited on swap-ins
# (12 s to a first token, 9 tok/s). Its own memory never swaps; everything else's still may.
MemorySwapMax=0

[Install]
WantedBy=default.target
